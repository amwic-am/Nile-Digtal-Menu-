# Copy to .env.local for local development. Replace every placeholder.
# URL-encode special characters in the database password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

JWT_SECRET=replace-with-a-long-random-secret
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-unique-password
