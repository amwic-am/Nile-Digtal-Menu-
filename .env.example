# Copy to .env.local for local development. Replace every placeholder.
# Keep service-role and database credentials server-side only.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require"
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[SUPABASE_PUBLISHABLE_OR_ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SUPABASE_SECRET_OR_SERVICE_ROLE_KEY]"
VITE_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="[SUPABASE_PUBLISHABLE_OR_ANON_KEY]"

# Used by npm run admin:update.
INITIAL_ADMIN_EMAIL="admin@example.com"
# Required to create an Auth user if one does not already exist.
INITIAL_ADMIN_PASSWORD="[UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS]"

# Supabase Auth must allow this redirect URL for staff invitations.
AUTH_REDIRECT_URL="http://localhost:5180/login"
